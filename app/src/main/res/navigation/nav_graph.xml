<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashScreen">

    <fragment
        android:id="@+id/splashScreen"
        android:name="com.ubaydullayev.expensetracker.presentation.splash.SplashScreen"
        android:label="screen_splash"
        tools:layout="@layout/screen_splash">

        <action
            android:id="@+id/action_splashScreen_to_onboardingScreen"
            app:destination="@id/onboardingScreen"
            app:enterAnim="@anim/splash_fade_in"
            app:exitAnim="@anim/splash_fade_out"
            app:popUpTo="@id/splashScreen"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_splashScreen_to_loginScreen"
            app:destination="@id/loginScreen"
            app:enterAnim="@anim/splash_fade_in"
            app:exitAnim="@anim/splash_fade_out"
            app:popUpTo="@id/splashScreen"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingScreen"
        android:name="com.ubaydullayev.expensetracker.presentation.splash.OnboardingScreen"
        android:label="screen_onboarding"
        tools:layout="@layout/screen_onboarding">

        <action
            android:id="@+id/action_onboardingScreen_to_loginScreen"
            app:destination="@id/loginScreen"
            app:popUpTo="@id/onboardingScreen"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginScreen"
        android:name="com.ubaydullayev.expensetracker.presentation.login.LoginScreen"
        android:label="screen_login"
        tools:layout="@layout/screen_login">

        <action
            android:id="@+id/action_loginScreen_to_loginSignUpScreen"
            app:destination="@id/loginSignUpScreen" />

        <action
            android:id="@+id/action_loginScreen_to_forgotPasswordScreen"
            app:destination="@id/forgotPasswordScreen" />

        <!-- On successful sign-in: enter the main graph (resolves to its start = home) and
             clear the auth flow so Back exits the app. Target the graph, not the inner
             homeScreen: navigating from outside into a nested graph must address the graph. -->
        <action
            android:id="@+id/action_loginScreen_to_homeScreen"
            app:destination="@id/mainGraph"
            app:popUpTo="@id/loginScreen"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginSignUpScreen"
        android:name="com.ubaydullayev.expensetracker.presentation.splash.LoginSignUpScreen"
        android:label="screen_login_sign_up"
        tools:layout="@layout/screen_login_sign_up">

        <!-- Return to the existing login instance instead of stacking a new one. -->
        <action
            android:id="@+id/action_loginSignUpScreen_to_loginScreen"
            app:destination="@id/loginScreen"
            app:popUpTo="@id/loginScreen"
            app:popUpToInclusive="false" />

        <!-- On successful sign-up: enter the main graph (resolves to its start = home) and
             clear the whole auth flow (login + sign-up). Target the graph, not inner homeScreen. -->
        <action
            android:id="@+id/action_loginSignUpScreen_to_homeScreen"
            app:destination="@id/mainGraph"
            app:popUpTo="@id/loginScreen"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordScreen"
        android:name="com.ubaydullayev.expensetracker.presentation.splash.ForgotPasswordScreen"
        android:label="screen_forgot_password"
        tools:layout="@layout/screen_forgot_password">

        <!-- Return to the existing login instance instead of stacking a new one. -->
        <action
            android:id="@+id/action_forgotPasswordScreen_to_loginScreen"
            app:destination="@id/loginScreen"
            app:popUpTo="@id/loginScreen"
            app:popUpToInclusive="false" />
    </fragment>

    <!-- Main app section: the four bottom-bar tabs plus the Add flow.
         Grouped so tab navigation can pop up to this graph's start (home)
         without touching the auth flow above. Home is the tab back-stack root. -->
    <navigation
        android:id="@+id/mainGraph"
        app:startDestination="@id/homeScreen">

        <fragment
            android:id="@+id/homeScreen"
            android:name="com.ubaydullayev.expensetracker.presentation.home.HomeScreen"
            android:label="screen_home"
            tools:layout="@layout/screen_home" />
        <fragment
            android:id="@+id/transactionScreen"
            android:name="com.ubaydullayev.expensetracker.presentation.transaction.TransactionScreen"
            android:label="screen_transaction"
            tools:layout="@layout/screen_transaction" />
        <fragment
            android:id="@+id/budgetScreen"
            android:name="com.ubaydullayev.expensetracker.presentation.budget.BudgetScreen"
            android:label="screen_budget"
            tools:layout="@layout/screen_budget" />
        <fragment
            android:id="@+id/profileScreen"
            android:name="com.ubaydullayev.expensetracker.presentation.profile.ProfileScreen"
            android:label="screen_profile"
            tools:layout="@layout/screen_profile" />
        <fragment
            android:id="@+id/addFabScreen"
            android:name="com.ubaydullayev.expensetracker.presentation.addfab.AddFabScreen"
            android:label="screen_add_fab"
            tools:layout="@layout/screen_add_fab" />

    </navigation>

</navigation>