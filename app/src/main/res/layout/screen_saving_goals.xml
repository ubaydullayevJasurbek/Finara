<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".presentation.savinggoals.SavingGoalsScreen">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/savingGoalsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ==================== HEADER ==================== -->
            <LinearLayout
                android:id="@+id/goalsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_extra_bold"
                        android:text="@string/saving_goals"
                        android:textColor="#0B0F14"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/_3_active_1_completed"
                        android:textColor="#6B7280"
                        android:textSize="13sp" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnAddSavingGoals"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_green_solid">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_add"
                        app:tint="@color/white" />

                </FrameLayout>

            </LinearLayout>

            <!-- ==================== OVERALL SAVINGS ==================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/overallSavingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_overall_savings_panel"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="-60dp"
                    android:layout_marginEnd="-40dp"
                    android:background="@drawable/bg_circle_white_translucent"
                    android:importantForAccessibility="no"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTotalSavedLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/total_saved"
                    android:textColor="#9FD9C0"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/progressRing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTotalSavedAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="$12,840"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    app:layout_constraintEnd_toStartOf="@id/progressRing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTotalSavedLabel" />

                <TextView
                    android:id="@+id/tvTargetSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="of $24,000 target"
                    android:textColor="#9FD9C0"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/progressRing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTotalSavedAmount" />

                <FrameLayout
                    android:id="@+id/progressRing"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/overallProgressIndicator"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:progress="53"
                        app:indicatorColor="@color/white"
                        app:indicatorSize="60dp"
                        app:trackColor="#33FFFFFF"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />

                    <TextView
                        android:id="@+id/tvOverallPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_extra_bold"
                        android:text="53%"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ==================== NEXT MILESTONE ==================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/milestoneCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_milestone_card"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/milestoneIconBg"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_milestone_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_flag"
                        app:tint="#B45309" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvMilestoneLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Next Milestone"
                    android:textColor="#92600A"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/milestoneIconBg"
                    app:layout_constraintTop_toTopOf="@id/milestoneIconBg" />

                <TextView
                    android:id="@+id/tvMilestoneValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="$1,160 more to reach $14,000 saved"
                    android:textColor="#0B0F14"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/milestoneIconBg"
                    app:layout_constraintTop_toBottomOf="@id/tvMilestoneLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ==================== ACTIVE GOALS ==================== -->
            <TextView
                android:id="@+id/tvActiveGoalsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_extra_bold"
                android:text="Active Goals"
                android:textColor="#0B0F14"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvActiveGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="3"
                tools:listitem="@layout/item_active_saving_goal" />

            <!-- Bu yerdan keyin: Completed, Upcoming/Planned bo'limlari -->
            <!-- ==================== UPCOMING / PLANNED ==================== -->
            <LinearLayout
                android:id="@+id/sectionPlanned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlannedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="Planned Goals"
                    android:textColor="#0B0F14"
                    android:textSize="18sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPlannedGoals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- ==================== COMPLETED ==================== -->
            <LinearLayout
                android:id="@+id/sectionCompleted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCompletedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="Completed"
                    android:textColor="#0B0F14"
                    android:textSize="18sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCompletedGoals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_completed_saving_goal" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/contributionHistoryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp">

                <TextView
                    android:id="@+id/tvContributionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="Contribution History"
                    android:textColor="#0B0F14"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toStartOf="@id/tvContributionPeriod"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvContributionPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="6 months"
                    android:textColor="#0B7E57"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvContributionTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvContributionTitle" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/contributionChartCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toBottomOf="@id/tvContributionTitle"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Ustunlar qatori -->
                        <LinearLayout
                            android:id="@+id/barsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:baselineAligned="false"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <!-- Har bir ustun: bo'sh joy (yuqoridan bosim) + ustunning o'zi -->
                            <!-- 6 ta ustun uchun namuna, ID'lar bar1..bar6 -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="bottom|center_horizontal"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/bar1"
                                    android:layout_width="22dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_contribution_bar_inactive" />

                                <TextView
                                    android:id="@+id/tvBarLabel1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="Oct"
                                    android:textColor="#9E9E9E"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="bottom|center_horizontal"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/bar2"
                                    android:layout_width="22dp"
                                    android:layout_height="52dp"
                                    android:background="@drawable/bg_contribution_bar_inactive" />

                                <TextView
                                    android:id="@+id/tvBarLabel2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="Nov"
                                    android:textColor="#9E9E9E"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="bottom|center_horizontal"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/bar3"
                                    android:layout_width="22dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_contribution_bar_inactive" />

                                <TextView
                                    android:id="@+id/tvBarLabel3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="Dec"
                                    android:textColor="#9E9E9E"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="bottom|center_horizontal"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/bar4"
                                    android:layout_width="22dp"
                                    android:layout_height="58dp"
                                    android:background="@drawable/bg_contribution_bar_inactive" />

                                <TextView
                                    android:id="@+id/tvBarLabel4"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="Jan"
                                    android:textColor="#9E9E9E"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="bottom|center_horizontal"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/bar5"
                                    android:layout_width="22dp"
                                    android:layout_height="82dp"
                                    android:background="@drawable/bg_contribution_bar_active" />

                                <TextView
                                    android:id="@+id/tvBarLabel5"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:fontFamily="@font/inter_extra_bold"
                                    android:text="Feb"
                                    android:textColor="#0B7E57"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="bottom|center_horizontal"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/bar6"
                                    android:layout_width="22dp"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_contribution_bar_inactive" />

                                <TextView
                                    android:id="@+id/tvBarLabel6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="Mar"
                                    android:textColor="#9E9E9E"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="14dp"
                            android:background="#EEEEEE" />

                        <!-- Average qatori -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_medium"
                                android:text="Avg. monthly contribution"
                                android:textColor="#6B7280"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tvAvgContribution"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_extra_bold"
                                android:text="$680"
                                android:textColor="#0B0F14"
                                android:textSize="15sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>