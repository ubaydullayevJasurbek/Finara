<?xml version="1.0" encoding="utf-8"?>
<!-- Profile: navy hero (Home bilan bir uslubda) + bo'limlar.
     Pastki menyudagi tab, shuning uchun orqaga tugmasi yo'q. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fin_bg"
    tools:context=".presentation.profile.ProfileScreen">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ==================== HERO ==================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profileHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_hero_layers"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/tvProfileTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="@string/profile_title"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:id="@+id/avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_profile_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileTitle">

                    <TextView
                        android:id="@+id/tvInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_extra_bold"
                        android:textColor="@color/fin_blue"
                        android:textSize="22sp"
                        tools:text="JU" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_profile_glass"
                    android:clickable="true"
                    android:contentDescription="@string/profile_edit_cd"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    app:layout_constraintBottom_toBottomOf="@id/avatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/avatar">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter_medium"
                        android:importantForAccessibility="no"
                        android:text="@string/profile_edit"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_extra_bold"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toTopOf="@id/tvEmail"
                    app:layout_constraintEnd_toStartOf="@id/btnEditProfile"
                    app:layout_constraintStart_toEndOf="@id/avatar"
                    app:layout_constraintTop_toTopOf="@id/avatar"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:text="Jasurbek Ubaydullayev" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/avatar"
                    app:layout_constraintEnd_toEndOf="@id/tvName"
                    app:layout_constraintStart_toStartOf="@id/tvName"
                    app:layout_constraintTop_toBottomOf="@id/tvName"
                    tools:text="jasurbek@gmail.com" />

                <LinearLayout
                    android:id="@+id/statsRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/avatar">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_profile_glass"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvStatTransactions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_extra_bold"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_medium"
                        android:maxLines="1"
                        android:text="@string/profile_stat_transactions"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_profile_glass"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvStatGoals"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_extra_bold"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_medium"
                        android:maxLines="1"
                        android:text="@string/profile_stat_goals"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_profile_glass"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvStatSince"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_extra_bold"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_medium"
                        android:maxLines="1"
                        android:text="@string/profile_stat_since"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Sign out / Delete / Reset bajarilayotganda -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBusy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/fin_blue"
                app:trackColor="@color/fin_blue_tint"
                app:trackCornerRadius="2dp" />

            <TextView
                style="@style/ProfileSectionLabel"
                android:layout_marginTop="18dp"
                android:text="@string/profile_section_preferences" />

            <com.google.android.material.card.MaterialCardView style="@style/ProfileCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowCurrency"
                        layout="@layout/item_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/ProfileRowDivider" />

                    <include
                        android:id="@+id/rowHideBalance"
                        layout="@layout/item_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/ProfileSectionLabel"
                android:layout_marginTop="22dp"
                android:text="@string/profile_section_data" />

            <com.google.android.material.card.MaterialCardView style="@style/ProfileCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowExport"
                        layout="@layout/item_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/ProfileRowDivider" />

                    <include
                        android:id="@+id/rowReset"
                        layout="@layout/item_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/ProfileSectionLabel"
                android:layout_marginTop="22dp"
                android:text="@string/profile_section_support" />

            <com.google.android.material.card.MaterialCardView style="@style/ProfileCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowSupport"
                        layout="@layout/item_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/ProfileRowDivider" />

                    <include
                        android:id="@+id/rowPrivacy"
                        layout="@layout/item_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/ProfileRowDivider" />

                    <include
                        android:id="@+id/rowAbout"
                        layout="@layout/item_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/ProfileSectionLabel"
                android:layout_marginTop="22dp"
                android:text="@string/profile_section_account" />

            <com.google.android.material.card.MaterialCardView style="@style/ProfileCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowSignOut"
                        layout="@layout/item_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/ProfileRowDivider" />

                    <include
                        android:id="@+id/rowDeleteAccount"
                        layout="@layout/item_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/fin_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/profile_local_note"
                    android:textColor="@color/fin_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
