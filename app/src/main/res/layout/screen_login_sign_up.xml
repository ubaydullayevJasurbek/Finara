<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".presentation.splash.LoginSignUpScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xl">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/login_logo_size"
                android:layout_height="@dimen/login_logo_size"
                android:importantForAccessibility="no"
                android:src="@drawable/finara_mark_brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/finara"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/create_account"
            android:textAppearance="@style/TextAppearance.Finara.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/sign_up_subtitle"
            android:textAppearance="@style/TextAppearance.Finara.Subtitle" />

        <!-- Full name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:labelFor="@id/nameEdit"
            android:text="@string/full_name"
            android:textAppearance="@style/TextAppearance.Finara.FieldLabel" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameLayout"
            style="@style/Widget.Finara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:startIconDrawable="@drawable/ic_person"
            android:hint="@string/hint_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameEdit"
                style="@style/Widget.Finara.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:imeOptions="actionNext"

                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:labelFor="@id/gmailEdit"
            android:text="@string/email"
            android:textAppearance="@style/TextAppearance.Finara.FieldLabel" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/gmailLayout"
            style="@style/Widget.Finara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/hint_email"
            app:startIconDrawable="@drawable/ic_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gmailEdit"
                style="@style/Widget.Finara.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:labelFor="@id/passwordEdit"
            android:text="@string/password"
            android:textAppearance="@style/TextAppearance.Finara.FieldLabel" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout"
            style="@style/Widget.Finara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/hint_password"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_password"
            tools:ignore="PrivateResource">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordEdit"
                style="@style/Widget.Finara.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:imeOptions="actionNext"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:labelFor="@id/confirmPasswordEdit"
            android:text="@string/confirm_password"
            android:textAppearance="@style/TextAppearance.Finara.FieldLabel" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmPasswordLayout"
            style="@style/Widget.Finara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/confirm_hint_password"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_password"
            tools:ignore="PrivateResource">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmPasswordEdit"
                style="@style/Widget.Finara.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Primary CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/createAccountBtn"
            style="@style/Widget.Finara.Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/create_account" />

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/divider_thickness"
                android:layout_weight="1"
                android:background="@color/surface_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_md"
                android:text="@string/or_continue_with"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/divider_thickness"
                android:layout_weight="1"
                android:background="@color/surface_border" />
        </LinearLayout>

        <!-- Social sign-up -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/appleBtn"
                style="@style/Widget.Finara.SocialButton"
                android:contentDescription="@string/cd_sign_in_apple"
                android:src="@drawable/ic_apple" />

            <ImageButton
                android:id="@+id/facebookBtn"
                style="@style/Widget.Finara.SocialButton"
                android:layout_marginStart="@dimen/social_button_gap"
                android:contentDescription="@string/cd_sign_in_facebook"
                android:src="@drawable/ic_facebook" />

            <ImageButton
                android:id="@+id/googleBtn"
                style="@style/Widget.Finara.SocialButton"
                android:layout_marginStart="@dimen/social_button_gap"
                android:contentDescription="@string/cd_sign_in_google"
                android:src="@drawable/ic_google" />

            <ImageButton
                android:id="@+id/twitterBtn"
                style="@style/Widget.Finara.SocialButton"
                android:layout_marginStart="@dimen/social_button_gap"
                android:contentDescription="@string/cd_sign_in_twitter"
                android:src="@drawable/ic_xtwitter" />
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_have_account"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/signInBtn"
                style="@style/Widget.Finara.TextLink"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/sign_in" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
