<?xml version="1.0" encoding="utf-8"?><!-- "+ New budget" plitkasi: to'rning oxirida, tepadagi alohida tugma o'rniga -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addTile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dashed_tile"
    android:clickable="true"
    android:contentDescription="@string/add_budget"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="150dp"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_accent_chip">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add"
            app:tint="@color/fin_blue" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_extra_bold"
        android:text="@string/budget_new"
        android:textColor="@color/fin_blue"
        android:textSize="13sp" />
</LinearLayout>