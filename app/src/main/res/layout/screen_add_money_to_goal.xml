<?xml version="1.0" encoding="utf-8"?>
<!-- Add Money: alohida to'liq ekran o'rniga ixcham bottom sheet.
     Maqsad chiplar bilan tanlanadi (alohida dialog shart emas), summa + tez qo'shish tugmalari. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    tools:context=".presentation.addmoney.AddMoneyToGoalScreen">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tint="@color/fin_border" />

    <!-- Sarlavha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_fin_icon_tile_orange">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_target"
                app:tint="@color/fin_orange_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_extra_bold"
                android:text="@string/add_money_title"
                android:textColor="@color/fin_navy"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_medium"
                android:text="@string/add_money_subtitle"
                android:textColor="@color/fin_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Maqsad -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/inter_medium"
        android:text="@string/add_money_goal_label"
        android:textColor="@color/fin_text_secondary"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:id="@+id/goalsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGoals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvNoGoals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_amount_field"
        android:fontFamily="@font/inter_medium"
        android:padding="14dp"
        android:text="@string/add_money_no_goals"
        android:textColor="@color/fin_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvGoalProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/fin_text_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="$4,080 of $6,000 saved · $1,920 to go"
        tools:visibility="visible" />

    <!-- Summa -->
    <LinearLayout
        android:id="@+id/amountBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_amount_field"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="16dp">

        <TextView
            android:id="@+id/tvAmountCurrency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/inter_extra_bold"
            android:textColor="@color/fin_text_secondary"
            android:textSize="24sp"
            tools:text="$" />

        <EditText
            android:id="@+id/etGoalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fontFamily="@font/inter_extra_bold"
            android:hint="0"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLength="10"
            android:minWidth="60dp"
            android:textColor="@color/fin_navy"
            android:textColorHint="#80092634"
            android:textSize="36sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAmountError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_medium"
        android:text="@string/add_money_amount_error"
        android:textColor="@color/fin_error"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Tez qo'shish: +10 / +50 / +100 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuick10"
            style="@style/Finara.QuickAmount"
            android:layout_marginEnd="8dp"
            tools:text="+$10" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuick50"
            style="@style/Finara.QuickAmount"
            android:layout_marginEnd="8dp"
            tools:text="+$50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuick100"
            style="@style/Finara.QuickAmount"
            tools:text="+$100" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmAddMoney"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/inter_extra_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/add_money_confirm"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/fin_blue"
        app:cornerRadius="16dp" />

</LinearLayout>
