<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".presentation.home.HomeScreen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="24dp"
            android:text="@string/good_morning"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/my_nameTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/my_name"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/textView"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/userAvatarBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:fontFamily="@font/inter_extra_bold"
            android:includeFontPadding="false"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="@string/am"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/brand_green_dark"
            app:cornerRadius="24dp"
            app:elevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/my_nameTxt"
            app:layout_constraintEnd_toEndOf="parent"
            app:rippleColor="@color/onb_white_20" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            app:backgroundTint="@color/brand_green_dark"
            app:cornerRadius="24dp"
            app:elevation="0dp"
            app:icon="@drawable/notification_icon"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/my_nameTxt"
            app:layout_constraintEnd_toStartOf="@+id/userAvatarBtn"
            app:rippleColor="@color/onb_white_20" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="272dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp"
            android:elevation="8dp"
            app:cardCornerRadius="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/my_nameTxt">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- ====== Dekorativ qatlam ======
                     match_parent balandlik — FrameLayout o'lchov qoidasiga ko'ra
                     bunday bolalar wrap_content hisobiga kirmaydi. Shuning uchun
                     kartaning balandligini faqat pastdagi kontent belgilaydi,
                     glow/ellipslar esa ortiqcha bo'sh joy hosil qilmaydi
                     (ortig'i kartaning yumaloq chetida clip bo'ladi). -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/panelBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_onb_panel_1" />

                    <!-- Dekorativ glow / ellipslar (Figma 167:16..167:18) -->
                    <View
                        android:layout_width="@dimen/onb_glow_top_size"
                        android:layout_height="@dimen/onb_glow_top_size"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="210dp"
                        android:layout_marginTop="-90dp"
                        android:background="@drawable/bg_onb_glow_top"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="@dimen/onb_glow_bottom_size"
                        android:layout_height="@dimen/onb_glow_bottom_size"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="-80dp"
                        android:background="@drawable/bg_onb_glow_bottom"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="156dp"
                        android:layout_gravity="center|end"
                        android:background="@drawable/ellipse"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="22dp">

                    <!-- Header: "Total Balance" + ko'z tugmasi -->
                    <TextView
                        android:id="@+id/totalBalanceTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:letterSpacing="0.01"
                        android:text="@string/total_balance"
                        android:textColor="@color/white_70"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="@+id/eyeToggle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/eyeToggle" />

                    <FrameLayout
                        android:id="@+id/eyeToggle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_eye_toggle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_eye"
                            app:tint="@color/white_70" />
                    </FrameLayout>

                    <!-- Balans summasi -->
                    <TextView
                        android:id="@+id/balanceTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/inter_extra_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:text="@string/balance_amount"
                        android:textColor="@color/white"
                        android:textSize="40sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/eyeToggle"
                        tools:ignore="UseCompatTextViewDrawableXml" />

                    <!-- Trend pill: yashil ↑ + "+$1,240 (11.2%) this month" -->
                    <LinearLayout
                        android:id="@+id/trendBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_trend_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/balanceTxt">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_up"
                            app:tint="@color/income_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/trend_this_month"
                            android:textColor="@color/white_95"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ============ INCOME / EXPENSE (Figma 167:30) ============
                         white 10% fon, 1dp white 12% border, 18dp radius.
                         Chapda Income, markazda vertikal chiziq, o'ngda Expense. -->
                    <LinearLayout
                        android:id="@+id/incomeExpenseBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_income_expense"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/trendBadge">

                        <!-- Income -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical|start"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_square">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_arrow_down"
                                    app:tint="@color/income_green" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/incomeLabelTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="@string/income"
                                    android:textColor="@color/white_65"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/incomeAmountTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/income_amount"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Vertikal divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="@color/white_15" />

                        <!-- Expense -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_square">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_arrow_up"
                                    app:tint="@color/expense_red" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/expenseLabelTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="@string/expense"
                                    android:textColor="@color/white_65"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/expenseAmountTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/expense_amount"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
