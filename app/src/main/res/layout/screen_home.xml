<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    tools:context=".presentation.home.HomeScreen">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Gorizontal padding yo'q: hero chetdan-chetga cho'ziladi,
             qolgan bo'limlar o'z marginHorizontal'iga ega.
             Bottom bar kontent ostida emas, uning tagida turadi. -->
        <LinearLayout
            android:id="@+id/homeContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ==================== 1. HERO ====================
                 Header + balans + Income/Expense + quick actions bitta
                 lojuvard gradient + oltin girih naqshi blokida. Status bar ostiga ham cho'ziladi: tepa
                 inset kodda (HomeScreen) paddingTop'ga qo'shiladi. -->
            <LinearLayout
                android:id="@+id/heroContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_hero_layers"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- Header: avatar | salomlashuv + ism | valyuta | bildirishnoma.
                     Tugmalar 48dp (touch target); inset'lar ko'rinadigan qismini
                     44dp/40dp qilib qoldiradi. -->
                <LinearLayout
                    android:id="@+id/headerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ivProfile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_profile"
                        android:fontFamily="@font/inter_extra_bold"
                        android:includeFontPadding="false"
                        android:insetLeft="2dp"
                        android:insetTop="2dp"
                        android:insetRight="2dp"
                        android:insetBottom="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="@string/am"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:backgroundTint="@color/onb_white_16"
                        app:cornerRadius="22dp"
                        app:elevation="0dp"
                        app:rippleColor="@color/onb_white_20"
                        app:strokeColor="@color/onb_white_20"
                        app:strokeWidth="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Matni kodda soatga qarab o'rnatiladi -->
                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/good_morning"
                            android:textColor="@color/white_70"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/my_name"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Joriy valyuta (UserPreferences.currencyCode); bosilsa Profile'da o'zgartiriladi -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCurrency"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/home_cd_currency"
                        android:insetTop="4dp"
                        android:insetBottom="4dp"
                        android:minWidth="48dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/home_currency_placeholder"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/onb_white_14"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_expand_more"
                        app:iconGravity="end"
                        app:iconPadding="2dp"
                        app:iconSize="14dp"
                        app:iconTint="@color/white"
                        app:elevation="0dp"
                        app:rippleColor="@color/onb_white_20" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotification"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_notifications"
                        android:insetLeft="2dp"
                        android:insetTop="2dp"
                        android:insetRight="2dp"
                        android:insetBottom="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/onb_white_14"
                        app:cornerRadius="22dp"
                        app:elevation="0dp"
                        app:icon="@drawable/notification_icon"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="@color/white"
                        app:rippleColor="@color/onb_white_20" />
                </LinearLayout>

                <!-- "Total balance" + ko'z tugmasi (markazda) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBalanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/total_balance"
                        android:textColor="@color/white_70"
                        android:textSize="13sp" />

                    <!-- 48dp touch target; inset'lar ko'rinadigan qismini 32dp qoldiradi.
                         Bosilganda balans/income/expense yashiriladi (HomeScreen). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleBalance"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_toggle_balance"
                        android:insetLeft="8dp"
                        android:insetTop="8dp"
                        android:insetRight="8dp"
                        android:insetBottom="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/white_12"
                        app:cornerRadius="16dp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_eye"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/white_70"
                        app:rippleColor="@color/onb_white_20" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotalBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_extra_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="@string/balance_amount"
                    android:textColor="@color/white"
                    android:textSize="38sp" />

                <!-- Trend + tejash foizi (eski Financial Health kartasi o'rniga) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/trendBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_trend_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:id="@+id/ivTrendArrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_up"
                            app:tint="@color/income_green" />

                        <TextView
                            android:id="@+id/tvMonthlyChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/trend_this_month"
                            android:textColor="@color/white_95"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/savingBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_saving_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_heart"
                            app:tint="@color/fin_orange_on_dark" />

                        <TextView
                            android:id="@+id/tvSavingRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/fin_orange_on_dark"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Saving 24%" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Income / Expense: ikki alohida glass chip -->
                <LinearLayout
                    android:id="@+id/incomeExpenseBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_income_expense"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_square"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/income_green" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/incomeLabelTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/income"
                                android:textColor="@color/white_70"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvIncome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/income_amount"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_income_expense"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_square"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_arrow_up"
                            app:tint="@color/expense_red" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/expenseLabelTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/expense"
                                android:textColor="@color/white_70"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvExpense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/expense_amount"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick actions: faqat ishlaydiganlari.
                     "Add" bottom bar'dagi "+" da, Statistics -> Budget tab.
                     Scan: OCR ulanmaguncha gone; ulangach visible qiling. -->
                <LinearLayout
                    android:id="@+id/quickActionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanReceipt"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/scan_receipt"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@color/onb_white_16"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/scan_qr_code"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/white"
                        app:rippleColor="@color/onb_white_20"
                        app:strokeColor="@color/onb_white_20"
                        app:strokeWidth="1dp"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddToGoal"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/home_add_to_goal"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/onb_white_16"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_target"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/white"
                        app:rippleColor="@color/onb_white_20"
                        app:strokeColor="@color/onb_white_20"
                        app:strokeWidth="1dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ==================== 2. SAFE TO SPEND ====================
                 Hero ustiga biroz chiqadi (-14dp). ViewModel hisob bergunicha
                 gone: runtime'da soxta raqam ko'rinmaydi. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSafeToSpend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-14dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/home_safe_to_spend"
                            android:textColor="@color/fin_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSafeStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_success_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textColor="@color/fin_success"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="On track" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSafeToSpend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_extra_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/fin_navy"
                        android:textSize="26sp"
                        tools:text="$84 / day" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressMonthlyBudget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:indicatorColor="@color/accent"
                        app:trackColor="@color/fin_blue_tint"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="6dp"
                        tools:progress="78" />

                    <TextView
                        android:id="@+id/tvSafeToSpendMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/fin_text_secondary"
                        android:textSize="12sp"
                        tools:text="$2,960 of $3,800 monthly budget · 10 days left" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== 3. UPCOMING BILLS ====================
                 Tepaga ko'tarildi: eng tez harakat talab qiladigan ma'lumot. -->
            <LinearLayout
                android:id="@+id/sectionUpcomingBills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUpcomingBillsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_upcoming_bills"
                        android:textColor="@color/fin_navy"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSeeUpcomingBills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text="@string/see_all"
                        android:textColor="@color/accent_dark"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUpcomingBills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_upcoming_bills_card" />
            </LinearLayout>

            <!-- ==================== 4. BUDGETS ==================== -->
            <LinearLayout
                android:id="@+id/sectionBudgets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBudgetsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/budgets"
                        android:textColor="@color/fin_navy"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSeeAllBudgets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text="@string/see_all"
                        android:textColor="@color/accent_dark"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/budgetRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_budget_cards" />
            </LinearLayout>

            <!-- ==================== 5. INSIGHT ====================
                 Eski qotirilgan AI Insight o'rniga. ViewModel o'tgan oy
                 bilan solishtirib matn bergunicha gone. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fin_border"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_square"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_lightbulb"
                        app:backgroundTint="@color/onb_tint_purple"
                        app:tint="@color/onb_accent_purple" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/home_insight"
                                android:textColor="@color/fin_navy"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvInsightPeriod"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/fin_text_secondary"
                                android:textSize="11sp"
                                tools:text="vs October" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvInsightText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/fin_navy"
                            android:textSize="13sp"
                            tools:text="You spent 18% more on Food this month." />

                        <TextView
                            android:id="@+id/btnInsightAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:textColor="@color/accent_dark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="See Food spending →" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== 6. SAVING GOALS ==================== -->
            <LinearLayout
                android:id="@+id/sectionSavingGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSavingGoalsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/saving_goals"
                        android:textColor="@color/fin_navy"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSeeAllSavingGoals"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text="@string/see_all"
                        android:textColor="@color/accent_dark"
                        android:textStyle="bold" />
                </LinearLayout>

                <include
                    android:id="@+id/includeGoalCard"
                    layout="@layout/item_goal_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ==================== 7. RECENT TRANSACTIONS ==================== -->
            <LinearLayout
                android:id="@+id/sectionRecentTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent_transactions"
                        android:textColor="@color/fin_navy"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSeeAllTransactions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text="@string/see_all"
                        android:textColor="@color/accent_dark"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fin_border"
                    app:strokeWidth="1dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecentTransactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>