<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fin_bg"
    tools:context=".presentation.budget.BudgetScreen">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/budgetScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- ==================== 1. SARLAVHA ==================== -->
            <TextView
                android:id="@+id/bgHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_extra_bold"
                android:text="@string/budget"
                android:textColor="@color/fin_navy"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/bgHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/fin_text_secondary"
                android:textSize="13sp"
                tools:text="November 2026" />

            <!-- ==================== 2. UMUMIY KARTA ====================
                 "Qancha qoldi" asosiy raqam, kunlik limit yonida, ostida
                 budjet taqsimoti chizig'i va legenda (kodda quriladi). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budgetOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/fin_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fin_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRemainingLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/budget_left_to_spend"
                                android:textColor="@color/fin_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_extra_bold"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.02"
                                android:textColor="@color/fin_navy"
                                android:textSize="36sp"
                                tools:text="$330" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/budget_daily"
                                android:textColor="@color/fin_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvDailyLeft"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_extra_bold"
                                android:textColor="@color/fin_blue"
                                android:textSize="18sp"
                                tools:text="$33" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Taqsimot chizig'i: segmentlar kodda qo'shiladi (har bir kategoriya + qolgan) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        app:cardBackgroundColor="@color/fin_blue_tint"
                        app:cardCornerRadius="7dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:id="@+id/shareBar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Legenda: "● Housing $1,200" (kodda), qatorlarga o'zi bo'linadi -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/legendGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="14dp"
                        app:chipSpacingVertical="6dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStatus"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clickable="false"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/fin_success"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/fin_success_tint"
                        app:chipCornerRadius="20dp"
                        app:chipIcon="@drawable/ic_check"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/fin_success"
                        app:chipStrokeWidth="0dp"
                        tools:text="Near limit · 83% used" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== 3. KATEGORIYALAR (2 ustunli to'r) ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCategoriesTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="@string/categories"
                    android:textColor="@color/fin_navy"
                    android:textSize="17sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditCategories"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extra_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="0dp"
                    android:text="@string/edit"
                    android:textColor="@color/fin_blue"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Budjet plitkalari + "New budget" + "Smart tip" plitkalari -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="4"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_budget_tile"
                tools:spanCount="2" />

            <!-- Budjet tarixi: hozircha yashirin. Undagi oylar va summalar layout'da
                 qotirib yozilgan (haqiqiy ma'lumot emas). Ma'lumotga ulangach VISIBLE qiling. -->
            <include
                android:id="@+id/budgetHistory"
                layout="@layout/layout_budget_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>