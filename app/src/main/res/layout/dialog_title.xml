<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog sarlavhasi: ikonka plitkasi + sarlavha. Dialogs.kt: setFinaraTitle orqali qo'yiladi.
     Plitka rangi kodda beriladi (oddiy ko'k, ogohlantirish to'q sariq, xavfli qizil). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/iconTile"
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_extra_bold"
        android:textColor="@color/fin_navy"
        android:textSize="19sp" />
</LinearLayout>
