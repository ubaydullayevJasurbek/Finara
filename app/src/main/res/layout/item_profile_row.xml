<?xml version="1.0" encoding="utf-8"?>
<!-- Profile ekranidagi bitta qator: ikonka, sarlavha, ixtiyoriy izoh, qiymat va chevron yoki switch.
     Ranglar ProfileScreen.setupRow() da beriladi (oddiy yoki xavfli qator). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRowIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        app:cardBackgroundColor="@color/fin_blue_tint"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/ivRowIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/fin_blue"
            tools:src="@drawable/ic_currency" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/fin_navy"
            android:textSize="15sp"
            tools:text="Currency" />

        <TextView
            android:id="@+id/tvRowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/fin_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Home opens with amounts hidden"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/fin_text_secondary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="USD $"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/fin_text_secondary" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
