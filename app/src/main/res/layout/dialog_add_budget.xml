<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_fin_icon_tile">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_grid"
            app:tint="@color/fin_blue" />

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_extra_bold"
        android:text="New budget"
        android:textColor="@color/fin_navy"
        android:textSize="19sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_medium"
        android:text="Set a monthly spending limit for one category"
        android:textColor="@color/fin_text_secondary"
        android:textSize="13sp" />

    <!-- Category tanlash qatori -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowSelectBudgetCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/fin_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/fin_border"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvBudgetCategoryLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="Category"
                android:textColor="@color/fin_text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/ivBudgetCategoryArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSelectedBudgetCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_extra_bold"
                android:text="Select category"
                android:textColor="@color/fin_navy"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/ivBudgetCategoryArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBudgetCategoryLabel" />

            <ImageView
                android:id="@+id/ivBudgetCategoryArrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/fin_text_secondary" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Limit summasi -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBudgetLimit"
        style="@style/Finara.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Monthly limit">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBudgetLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textColor="@color/fin_navy" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>