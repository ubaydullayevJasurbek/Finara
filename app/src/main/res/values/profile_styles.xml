<?xml version="1.0" encoding="utf-8"?>
<!-- Profile ekranidagi takrorlanuvchi elementlar -->
<resources>

    <style name="ProfileSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">26dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/fin_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ProfileCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">20dp</item>
        <item name="cardBackgroundColor">@color/fin_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/fin_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="ProfileRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">68dp</item>
        <item name="android:background">@color/fin_border</item>
    </style>
</resources>
