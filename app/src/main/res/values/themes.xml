<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme.
         Light-only: the UI is designed for a white surface. Using the Light parent
         (not DayNight) keeps colorSurface white even when the system is in Dark Mode.
         windowBackground + colorSurface are pinned to pure white so ?attr/colorSurface
         backgrounds render the intended white in both preview and on-device. -->
    <style name="Base.Theme.ExpenseTracker" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <!-- Finara palitrasi (finara_colors.xml). Bular bo'lmasa Material 3 standart
             binafsha (#6750A4) ishlatiladi: switch, matn maydoni, dialog tugmalari va h.k. -->
        <item name="colorPrimary">@color/fin_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/fin_blue_tint</item>
        <item name="colorOnPrimaryContainer">@color/fin_navy</item>
        <item name="colorSecondary">@color/fin_navy</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/fin_blue_tint</item>
        <item name="colorOnSecondaryContainer">@color/fin_navy</item>
        <!-- To'q sariq ustida oq matn o'qilmaydi (2.78:1), shuning uchun navy -->
        <item name="colorTertiary">@color/fin_orange</item>
        <item name="colorOnTertiary">@color/fin_navy</item>
        <item name="colorError">@color/fin_error</item>
        <item name="colorOnError">@color/white</item>
        <!-- Soyali kartalar (masalan Home "Safe to spend") binafsha tus olmasin -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Light-only UI: opt out of platform/OEM Force Dark auto-inversion (API 29+). -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.ExpenseTracker" parent="Base.Theme.ExpenseTracker" />

    <!--
      System splash theme (androidx.core:core-splashscreen). Shown by the OS during cold start
      on every supported API (backported to 24+, native on Android 12+). This removes the blank/
      white window before the first frame. It hands off to the real app theme via
      postSplashScreenTheme, and MainActivity then shows the animated splash Fragment.
    -->
    <style name="Theme.ExpenseTracker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ExpenseTracker</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppBottomSheetStyle</item>
        <!-- Bottom sheet'lar alohida mavzuda: Finara ranglarini bu yerga ham beramiz -->
        <item name="colorPrimary">@color/fin_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/fin_blue_tint</item>
        <item name="colorOnPrimaryContainer">@color/fin_navy</item>
        <item name="colorSecondaryContainer">@color/fin_blue_tint</item>
        <item name="colorOnSecondaryContainer">@color/fin_navy</item>
        <item name="colorError">@color/fin_error</item>
    </style>

    <style name="AppBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/AppShapeAppearanceBottomSheet</item>
        <!-- Pin the rounded sheet surface to pure white (M3 colorSurface is slightly off-white). -->
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="AppShapeAppearanceBottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>