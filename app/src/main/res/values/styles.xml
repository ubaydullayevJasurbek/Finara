<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Splash text styles (Material 3 TextAppearance) ===== -->

    <!-- "Finara" wordmark -->
    <style name="TextAppearance.Finara.Wordmark" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/splash_wordmark_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- "Personal Finance Manager" tagline -->
    <style name="TextAppearance.Finara.Tagline" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/splash_tagline_text</item>
        <item name="android:textColor">@color/splash_white_85</item>
    </style>

    <!-- "Securing your data…" status line -->
    <style name="TextAppearance.Finara.Status" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/splash_status_text</item>
        <item name="android:textColor">@color/splash_white_70</item>
    </style>

    <!-- ===== Splash Activity typography (exact Figma 267:14 values, Inter) ===== -->
    <!-- 267:29 "Finara": Inter ExtraBold 34, white, tracking -1.02px (-1.02/34 = -0.03em) -->
    <style name="TextAppearance.Finara.Splash.Wordmark" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/inter_extra_bold</item>
        <item name="android:textSize">@dimen/splash_wordmark_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 267:30 "Personal Finance Manager": Inter Medium 13, white 60%, tracking 0.26px (0.02em) -->
    <style name="TextAppearance.Finara.Splash.Tagline" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">@dimen/splash_tagline_size</item>
        <item name="android:textColor">@color/splash_white_60</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 267:34 "Securing your data…": Inter Medium 12, white 50% -->
    <style name="TextAppearance.Finara.Splash.Status" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">@dimen/splash_status_size</item>
        <item name="android:textColor">@color/splash_white_50</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- res/values/themes.xml yoki styles.xml -->
    <style name="Button.GetStarted" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- ===== Onboarding ===== -->
    <!-- Illustration panel: only the bottom corners are rounded (top sits at the screen edge). -->
    <style name="ShapeAppearance.Onb.Panel" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">@dimen/onb_panel_corner</item>
        <item name="cornerSizeBottomRight">@dimen/onb_panel_corner</item>
    </style>

    <!-- Sign In brand panel: only the bottom corners rounded, top square (sits at the screen edge). -->
    <style name="ShapeAppearance.Sign.Panel" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">@dimen/login_panel_corner</item>
        <item name="cornerSizeBottomRight">@dimen/login_panel_corner</item>
    </style>

    <!-- 254:39 title: Inter ExtraBold 30, #0B0F14, centre, tracking -0.9px (-0.03em) -->
    <style name="TextAppearance.Onb.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/inter_extra_bold</item>
        <item name="android:textSize">@dimen/onb_title_text</item>
        <item name="android:textColor">@color/onb_text_primary</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 254:40 subtitle: Inter Medium 15, #6B7280, centre, line-height 1.5 -->
    <style name="TextAppearance.Onb.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">@dimen/onb_subtitle_text</item>
        <item name="android:textColor">@color/onb_text_secondary</item>
    </style>

    <!-- ============================================================= -->
    <!-- Login screen                                                  -->
    <!-- ============================================================= -->

    <!-- Typography -->
    <style name="TextAppearance.Finara.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/login_title_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Finara.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Finara.FieldLabel" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Rounded corners shared by the outlined text fields -->
    <style name="ShapeAppearance.Finara.TextField" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/input_corner_radius</item>
    </style>

    <!-- Outlined email/password field wrapper -->
    <style name="Widget.Finara.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Finara.TextField</item>
        <item name="boxStrokeWidth">@dimen/input_stroke_width</item>
        <item name="boxStrokeColor">@color/input_box_stroke</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="hintTextColor">@color/brand_green</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="errorEnabled">true</item>
    </style>

    <style name="Widget.Finara.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Primary gradient CTA. android:background carries the gradient, so
         backgroundTint is cleared and insets zeroed to honour the 56dp height. -->
    <style name="Widget.Finara.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_gradient</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/input_corner_radius</item>
    </style>

    <!-- Inline text links (Forgot password / Sign up) with ripple + 48dp target -->
    <style name="Widget.Finara.TextLink" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/space_sm</item>
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- Outlined, rippled social sign-in icon button -->
    <style name="Widget.Finara.SocialButton" parent="">
        <item name="android:layout_width">@dimen/social_button_size</item>
        <item name="android:layout_height">@dimen/social_button_size</item>
        <item name="android:padding">@dimen/social_button_padding</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">@drawable/bg_social_button</item>
    </style>

    <!-- Sign In: labelled outlined social pill (icon + text), used two-up with equal weight. -->
    <style name="Widget.Finara.SocialPill" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/login_social_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/login_social_corner</item>
        <item name="strokeColor">@color/social_pill_stroke</item>
        <item name="strokeWidth">@dimen/input_stroke_width</item>
        <item name="backgroundTint">@color/social_pill_bg</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/login_social_icon_gap</item>
        <item name="iconTint">@null</item>
        <item name="android:textColor">@color/social_pill_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
