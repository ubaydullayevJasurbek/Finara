<?xml version="1.0" encoding="utf-8"?>
<!-- Transactions banneri: bir tekis ko'k, burchakda yarim aylana halqa.
     Home'dagi girih naqshi faqat Home'da qoladi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fin_blue" />
            <corners
                android:bottomLeftRadius="30dp"
                android:bottomRightRadius="30dp" />
        </shape>
    </item>
    <item
        android:width="230dp"
        android:height="230dp"
        android:gravity="top|end"
        android:right="-90dp"
        android:top="-100dp">
        <shape android:shape="oval">
            <stroke
                android:width="28dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
    <item
        android:width="140dp"
        android:height="140dp"
        android:bottom="-70dp"
        android:gravity="bottom|start"
        android:left="-50dp">
        <shape android:shape="oval">
            <solid android:color="#0DFFFFFF" />
        </shape>
    </item>
</layer-list>
