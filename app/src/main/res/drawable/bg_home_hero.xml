<?xml version="1.0" encoding="utf-8"?>
<!-- Home hero: ko'k -> navy gradient (Finara palitrasi),
     faqat pastki burchaklari yumaloq (30dp). Ustiga bg_hero_girih chiziladi. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/fin_hero_mid"
        android:endColor="@color/fin_navy"
        android:startColor="@color/fin_blue"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="30dp"
        android:bottomRightRadius="30dp"
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp" />
</shape>