<?xml version="1.0" encoding="utf-8"?>
<!-- Splash background. Figma frame 267:14:
     linear-gradient(105.769deg, #127352 0%, #084533 37.931%, #08211C 68.966%).
     Rendered as a VectorDrawable so the exact 105.769° angle is preserved (a <shape>
     linear gradient only supports 45° increments). Start/end points are the CSS
     gradient-line projection for a 390x844 box. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="390dp"
    android:height="844dp"
    android:viewportWidth="390"
    android:viewportHeight="844">
    <path android:pathData="M0,0L390,0L390,844L0,844Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="-96.09"
                android:startY="339.62"
                android:endX="486.09"
                android:endY="504.38">
                <item android:offset="0" android:color="@color/splash_grad_start" />
                <item android:offset="0.37931" android:color="@color/splash_grad_mid" />
                <item android:offset="0.68966" android:color="@color/splash_grad_end" />
                <item android:offset="1" android:color="@color/splash_grad_end" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
