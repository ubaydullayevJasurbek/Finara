<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 267:15: 340dp radial glow, #33E69E @34% center -> transparent edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="@dimen/splash_glow_top_radius"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="@color/splash_glow_top"
        android:endColor="@color/splash_glow_top_edge" />
</shape>
