<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 254:16: 220dp radial glow, #0D8C61 @40% -> transparent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="@dimen/onb_glow_bottom_radius"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="@color/onb_glow_bottom"
        android:endColor="@color/onb_glow_bottom_edge" />
</shape>
