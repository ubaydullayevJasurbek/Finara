<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 254:15: 260dp radial glow, #33D999 @34% -> transparent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="@dimen/onb_glow_top_radius"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="@color/onb_glow_top"
        android:endColor="@color/onb_glow_top_edge" />
</shape>
