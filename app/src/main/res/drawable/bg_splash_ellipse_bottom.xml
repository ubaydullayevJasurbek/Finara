<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom-right blurred background circle (Figma node 16:28).
    Figma: 300dp white circle @ ~8% opacity with a large layer blur.

    Reproduced with a radial gradient (see top_ellipse.xml) so no unsupported
    SVG blur filter is needed. Host View is @dimen/splash_circle_bottom_size
    (380dp = 300 circle + blur falloff), centred on the circle centre.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.5"
        android:centerY="0.5"
        android:gradientRadius="190dp"
        android:startColor="#14FFFFFF"
        android:centerColor="#0FFFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
