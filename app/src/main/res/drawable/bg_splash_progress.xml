<?xml version="1.0" encoding="utf-8"?>
<!--
  Determinate progress bar for the splash (Figma 267:32 track + 267:33 fill):
  white @16% rounded track, with a #66F2B2 -> white @95% gradient fill revealed by progress.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/splash_track_radius" />
            <solid android:color="@color/splash_white_16" />
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/splash_track_radius" />
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="@color/splash_progress_fill_start"
                    android:endColor="@color/splash_white_95" />
            </shape>
        </clip>
    </item>
</layer-list>
