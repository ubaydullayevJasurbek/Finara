<?xml version="1.0" encoding="utf-8"?>
<!--
  Determinate progress bar: rounded (pill) white track with a purple fill.
  The three stacked semi-transparent "shadow" layers of the old version caused extra
  overdraw and mis-aligned the bar; removed. Rounded corners match an 8dp-tall pill.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/brand_badge_green" />
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <solid android:color="@color/white" />
            </shape>
        </clip>
    </item>
</layer-list>
